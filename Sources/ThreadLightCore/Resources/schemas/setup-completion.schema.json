{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadlight.dev/schemas/setup-completion-v2.json",
  "title": "ThreadLight Administrator Completion Response",
  "type": "object",
  "required": ["schemaVersion", "requestID", "requestSHA256", "createdAt", "organizationName", "enterpriseDomain", "clientID", "redirectURI", "requiredScope", "completedRequirements", "administratorCompletedAt", "legalOAuthRequired", "tokenTransferProhibited", "legalNextStep"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "requestID": { "type": "string", "format": "uuid" },
    "requestSHA256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "organizationName": { "type": "string", "minLength": 1 },
    "enterpriseDomain": { "type": "string", "minLength": 1 },
    "clientID": { "type": "string", "minLength": 1 },
    "redirectURI": { "const": "threadlight://oauth/callback" },
    "requiredScope": { "const": "admin.legal_holds:read" },
    "completedRequirements": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["internalApp", "pkce", "readScope", "enterpriseInstall", "exportAccess"] }
    },
    "administratorCompletedAt": { "type": "string", "format": "date-time" },
    "legalOAuthRequired": { "const": true },
    "tokenTransferProhibited": { "const": true },
    "legalNextStep": { "type": "string" }
  },
  "additionalProperties": false
}
