{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadlight.dev/schemas/signature-v2.json",
  "title": "ThreadLight Signature Envelope",
  "type": "object",
  "required": ["schemaVersion", "algorithm", "keyID", "publicKey", "manifestSHA256", "signature", "signedAt"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "algorithm": { "const": "ES256" },
    "keyID": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "publicKey": { "type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$" },
    "manifestSHA256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "signature": { "type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$" },
    "signedAt": { "type": "string", "format": "date-time", "description": "Covered by the ES256 signature; not an independent trusted timestamp." }
  },
  "additionalProperties": false
}
